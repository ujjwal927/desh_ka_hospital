<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Aapna Hospital | Neurology</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: Arial, sans-serif;
      scroll-behavior: smooth;
    }

    :root {
      --primary: #087f8c;
      --secondary: #12b8a6;
      --dark: #12343b;
      --light: #f2fbfc;
      --gray: #64748b;
      --white: #ffffff;
    }

    body {
      background: white;
      color: var(--dark);
    }

    /* NAVBAR */
    nav {
      height: 75px;
      padding: 0 7%;
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: white;
      box-shadow: 0 2px 15px rgba(0,0,0,0.08);
      position: sticky;
      top: 0;
      z-index: 1000;
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 24px;
      font-weight: bold;
      color: var(--primary);
    }

    .logo-icon {
      width: 40px;
      height: 40px;
      background: var(--primary);
      color: white;
      border-radius: 10px;
      display: flex;
      justify-content: center;
      align-items: center;
      font-size: 25px;
    }

    nav ul {
      display: flex;
      list-style: none;
      gap: 25px;
      align-items: center;
    }

    nav a {
      text-decoration: none;
      color: var(--dark);
      font-weight: 600;
    }

    nav a:hover {
      color: var(--primary);
    }

    .appointment-btn {
      background: var(--primary);
      color: white !important;
      padding: 11px 20px;
      border-radius: 25px;
    }

    /* HERO */
    .hero {
      min-height: 500px;
      display: flex;
      align-items: center;
      padding: 70px 7%;
      color: white;

      background:
        linear-gradient(
          rgba(8,127,140,0.90),
          rgba(18,184,166,0.85)
        ),
        url("https://images.unsplash.com/photo-1559757175-0eb30cd8c063?auto=format&fit=crop&w=1600&q=80");

      background-size: cover;
      background-position: center;
    }

    .hero-content {
      max-width: 700px;
    }

    .hero span {
      background: rgba(255,255,255,0.18);
      padding: 8px 16px;
      border-radius: 25px;
      display: inline-block;
      margin-bottom: 20px;
    }

    .hero h1 {
      font-size: clamp(42px, 6vw, 65px);
      margin-bottom: 20px;
    }

    .hero p {
      font-size: 18px;
      line-height: 1.7;
      margin-bottom: 30px;
    }

    .btn {
      display: inline-block;
      text-decoration: none;
      padding: 14px 25px;
      border-radius: 30px;
      font-weight: bold;
      transition: 0.3s;
    }

    .btn-white {
      background: white;
      color: var(--primary);
    }

    .btn-outline {
      border: 2px solid white;
      color: white;
      margin-left: 10px;
    }

    .btn:hover {
      transform: translateY(-3px);
    }

    /* CONTENT */
    section {
      padding: 75px 7%;
    }

    .section-title {
      text-align: center;
      margin-bottom: 45px;
    }

    .section-title span {
      color: var(--secondary);
      font-weight: bold;
    }

    .section-title h2 {
      font-size: 38px;
      margin: 8px 0;
    }

    .section-title p {
      color: var(--gray);
    }

    /* ABOUT NEUROLOGY */
    .about {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 50px;
      align-items: center;
    }

    .about-image img {
      width: 100%;
      border-radius: 25px;
    }

    .about-text h2 {
      font-size: 38px;
      margin-bottom: 20px;
    }

    .about-text p {
      color: var(--gray);
      line-height: 1.8;
      margin-bottom: 15px;
    }

    /* CONDITIONS */
    .conditions {
      background: var(--light);
    }

    .condition-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 22px;
    }

    .condition-card {
      background: white;
      padding: 25px;
      border-radius: 18px;
      border: 1px solid #e1eeee;
      transition: 0.3s;
    }

    .condition-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 10px 30px rgba(0,0,0,0.08);
    }

    .condition-icon {
      font-size: 35px;
      margin-bottom: 12px;
    }

    .condition-card h3 {
      margin-bottom: 8px;
    }

    .condition-card p {
      color: var(--gray);
      font-size: 14px;
    }

    /* SERVICES */
    .service-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 22px;
    }

    .service-card {
      padding: 28px;
      background: white;
      border-radius: 18px;
      border: 1px solid #e1eeee;
      transition: 0.3s;
    }

    .service-card:hover {
      border-color: var(--secondary);
      box-shadow: 0 10px 30px rgba(8,127,140,0.08);
    }

    .service-card h3 {
      margin-bottom: 10px;
    }

    .service-card p {
      color: var(--gray);
    }

    /* DOCTOR */
    .doctor-section {
      background: var(--light);
    }

    .doctor {
      max-width: 700px;
      margin: auto;
      background: white;
      padding: 30px;
      border-radius: 20px;
      display: flex;
      gap: 25px;
      align-items: center;
      box-shadow: 0 8px 30px rgba(0,0,0,0.07);
    }

    .doctor img {
      width: 160px;
      height: 160px;
      object-fit: cover;
      border-radius: 50%;
    }

    .doctor h2 {
      margin-bottom: 8px;
    }

    .doctor h4 {
      color: var(--primary);
      margin-bottom: 12px;
    }

    .doctor p {
      color: var(--gray);
    }

    /* CTA */
    .cta {
      text-align: center;
      color: white;
      background: linear-gradient(
        135deg,
        var(--primary),
        var(--secondary)
      );
    }

    .cta h2 {
      font-size: 40px;
      margin-bottom: 15px;
    }

    .cta p {
      margin-bottom: 25px;
    }

    /* FOOTER */
    footer {
      background: var(--dark);
      color: white;
      text-align: center;
      padding: 35px 20px;
    }

    footer p {
      color: #b7ced1;
      margin-top: 8px;
    }

    /* MOBILE */
    @media(max-width: 800px) {

      nav ul li:not(:last-child) {
        display: none;
      }

      .about {
        grid-template-columns: 1fr;
      }

      .condition-grid,
      .service-grid {
        grid-template-columns: 1fr 1fr;
      }

      .doctor {
        flex-direction: column;
        text-align: center;
      }
    }

    @media(max-width: 550px) {

      nav {
        padding: 0 5%;
      }

      .hero {
        padding: 60px 5%;
      }

      section {
        padding: 60px 5%;
      }

      .condition-grid,
      .service-grid {
        grid-template-columns: 1fr;
      }

      .hero h1 {
        font-size: 42px;
      }

      .btn-outline {
        margin-left: 0;
        margin-top: 10px;
      }
    }
  </style>
</head>

